{
  "name": "auto-game-lite",
  "version": "1.0.0",
  "private": true,
  "description": "Bản lite treo 24/7 cho Render free — không Next.js, UI tối giản",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "tsx src/server.ts",
    "start:prod": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "express": "^4.21.2",
    "tsx": "^4.19.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.19",
    "typescript": "^5.9.3"
  }
}

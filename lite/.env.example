# Cổng Render sẽ inject PORT tự động
PORT=3000

# Mật khẩu bảo vệ UI/API (bắt buộc trên Render). Header: x-api-key hoặc ?key=
LITE_API_KEY=doi-thanh-mat-khau-manh

# Tự ping chính mình mỗi N phút để giảm sleep (Render free vẫn nên dùng cron ngoài)
SELF_PING_MINUTES=10

# URL public của service (Render), dùng cho self-ping. Ví dụ: https://auto-game-lite.onrender.com
PUBLIC_URL=

# Giới hạn log mỗi account (tiết kiệm RAM)
MAX_LOGS_PER_ACCOUNT=80

# Delay tối thiểu giữa các vòng farm (ms) — tăng nếu bị rate-limit
MIN_FARM_DELAY_MS=800
